# Firebase web app configuration
# Copy this file to .env and fill in the values from
# Firebase console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# AI (optional)
# Gemini model used through Firebase AI Logic (free tier on the Spark plan)
VITE_GEMINI_MODEL=gemini-3.5-flash-lite
# reCAPTCHA Enterprise (Fraud Defense) site key for Firebase App Check (public, not a secret)
VITE_RECAPTCHA_SITE_KEY=
