# Firebase Configuration
# These are safe to expose - they're for client-side Firebase SDK
# Security is handled by Firebase Security Rules, not by hiding these values

# Get these from Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=traddii.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=traddii
VITE_FIREBASE_STORAGE_BUCKET=traddii.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Optional: Analytics
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
