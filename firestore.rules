rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================================
    // TRADING JOURNAL RULES
    // ===========================================
    match /trades/{tradeId} {
      // Allow create if authenticated and userId in the data matches auth uid
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Allow read and delete if authenticated and userId matches
      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      // Allow update only by the owner, and the owner cannot be changed
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // ===========================================
    // JOURNAL NOTES RULES
    // ===========================================
    match /journal_notes/{noteId} {
      // Allow create if authenticated and userId in the data matches auth uid
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Allow read and delete if authenticated and userId matches
      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      // Allow update only by the owner, and the owner cannot be changed
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ===========================================
    // EMAIL SUBSCRIPTIONS - PUBLIC FORM
    // ===========================================
    match /emailSubscriptions/{subscriptionId} {
      // Anyone can subscribe. The document ID is the lowercased email, so a
      // second signup for the same address is an update and gets rejected.
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'status', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && subscriptionId == request.resource.data.email
                    && request.resource.data.status == 'active'
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 50
                    && request.resource.data.subscribedAt == request.time;

      // Subscriber list is only accessible from the Firebase console / Admin SDK
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
