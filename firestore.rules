rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================================
    // TRADING JOURNAL RULES
    // ===========================================
    match /trades/{tradeId} {
      // Allow create if authenticated and userId in the data matches auth uid
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Allow read, update, delete if authenticated and userId matches
      allow read, update, delete: if request.auth != null
                                   && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ===========================================
    // EMAIL SUBSCRIPTIONS - PUBLIC FORM
    // ===========================================
    match /emailSubscriptions/{subscriptionId} {
      // Public can create subscriptions
      allow create: if request.auth == null
                    && request.resource.data.keys().hasAll(['email', 'subscribedAt', 'status', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && request.resource.data.status == 'active'
                    && request.resource.data.subscribedAt is timestamp;

      // Only admins can read/update/delete
      // Temporarily allow authenticated users to read
      allow read, update, delete: if request.auth != null;
      // Change to this later when you set up admin claims:
      // allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
